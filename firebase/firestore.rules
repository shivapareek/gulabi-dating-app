rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function inMatch(matchId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Users cannot give themselves a blue tick or premium; admins set those.
      allow create: if isUser(uid)
        && request.resource.data.verified == false
        && request.resource.data.premium == false;
      allow update: if isUser(uid)
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.premium == resource.data.premium;
      allow delete: if isUser(uid);

      // My decisions. The other person may read the one about them (match check).
      match /swipes/{otherUid} {
        allow read: if isUser(uid) || isUser(otherUid);
        allow write: if isUser(uid);
      }
      // People who liked me. Written by the liker, read/cleared by me.
      match /likes/{likerUid} {
        allow read: if isUser(uid);
        allow create, update: if isUser(likerUid);
        allow delete: if isUser(uid) || isUser(likerUid);
      }
    }

    match /matches/{matchId} {
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2;

      match /messages/{msgId} {
        allow read: if inMatch(matchId);
        allow create: if inMatch(matchId) && request.resource.data.from == request.auth.uid;
        allow update: if inMatch(matchId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
  }
}
